# Copy this file to .env and adjust only what you need.
# The application loads .env automatically. Never commit the real file.

# Optional outbound integration. Empty means that webhook delivery is disabled.
# WEBHOOK_URL=https://example.com/webhook
WEBHOOK_URL=

# Local files (both real files are ignored by Git).
COOKIES_FILE=cookies.json
TARGETS_FILE=targets.json
DB_FILE=mercadolivre-products.sqlite

# Optional affiliate tag. When empty, the app tries to read it from the orgnickp cookie.
AFFILIATE_TAG=

# Collection defaults
PRODUCT_LIMIT=5
MAX_PAGES=5
FETCH_RETRIES=2
REQUEST_TIMEOUT_MS=30000
RESEND_AFTER_HOURS=48
LOOP_ENABLED=true
LOOP_DELAY_MS=60000

# Service window
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=22
QUIET_HOURS_END=7
QUIET_HOURS_TIMEZONE=America/Sao_Paulo
QUIET_HOURS_RECHECK_MS=300000

# Request pacing
LISTING_REQUEST_DELAY_MIN_MS=180000
LISTING_REQUEST_DELAY_MAX_MS=300000
PRODUCT_REQUEST_DELAY_MIN_MS=5000
PRODUCT_REQUEST_DELAY_MAX_MS=10000
